# MySQL 配置
MYSQL_ROOT_PASSWORD=your_mysql_root_password

# Redis 配置
REDIS_PASSWORD=your_redis_password

# RedisCommander 管理员后台配置
ADMIN_USER=your_admin_user
ADMIN_PASSWORD=your_admin_password

# RocketMQ 配置
ROCKETMQ_ACCESS_KEY=your_rocketmq_access_key
ROCKETMQ_SECRET_KEY=your_rocketmq_secret_key
ROCKETMQ_NAMESRV_ADDR=127.0.0.1:9876
ROCKETMQ_PRODUCER_GROUP=s-pay-mall-group

# 应用日志路径
APP_LOG_PATH=./data/log

# 微信公众号配置
WEIXIN_ORIGINAL_ID=gh_xxxxxxxx
WEIXIN_TOKEN=your_weixin_token
WEIXIN_APP_ID=your_weixin_app_id
WEIXIN_APP_SECRET=your_weixin_app_secret
WEIXIN_TEMPLATE_ID=your_weixin_template_id
# 微信公众平台测试号 - 订单支付成功模板 ID
WEIXIN_TEMPLATE_ID_PAY_SUCCESS=your_weixin_pay_success_template_id

# 支付宝配置
ALIPAY_APP_ID=your_alipay_app_id
ALIPAY_MERCHANT_PRIVATE_KEY=your_alipay_merchant_private_key
ALIPAY_PUBLIC_KEY=your_alipay_public_key
ALIPAY_NOTIFY_URL=https://your-domain.example/pay-api/v1/alipay/alipay_notify_url
ALIPAY_RETURN_URL=https://your-domain.example/orders

# JWT
JWT_SECRET=replace_with_a_random_secret_at_least_32_bytes
