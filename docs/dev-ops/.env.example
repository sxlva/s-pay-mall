# ===========================================
# s-pay-mall 本地环境启动配置清单
# ===========================================

# ==================== 数据库配置 ====================
# MySQL root 密码（本地开发环境）
MYSQL_ROOT_PASSWORD=root123456

# ==================== Redis配置 ====================
# Redis 密码（本地开发环境，若无密码可留空）
REDIS_PASSWORD=

# ==================== Redis管理员后台配置 ====================
ADMIN_USER=
ADMIN_PASSWORD=

# ==================== RocketMQ配置 ====================
ROCKETMQ_ACCESS_KEY=
ROCKETMQ_SECRET_KEY=
# RocketMQ NameServer 地址
ROCKETMQ_NAMESRV_ADDR=127.0.0.1:9876

# RocketMQ 生产者组名
ROCKETMQ_PRODUCER_GROUP=s-pay-mall-group

# ==================== 微信公众号配置 ====================
# 微信公众号原始ID
WEIXIN_ORIGINAL_ID=gh_xxxxxxxx

# 微信公众号 Token（用于消息验证）
WEIXIN_TOKEN=your_weixin_token

# 微信公众号 AppID
WEIXIN_APP_ID=wx1234567890abcdef

# 微信公众号 AppSecret
WEIXIN_APP_SECRET=your_app_secret_here

# 微信模板消息ID（通用通知）
WEIXIN_TEMPLATE_ID=template_id_here

# 微信支付成功通知模板ID
WEIXIN_TEMPLATE_ID_PAY_SUCCESS=pay_success_template_id

# ==================== 支付宝沙箱配置 ====================
# 支付宝沙箱 AppID
ALIPAY_APP_ID=

# 支付宝商户私钥（RSA2）
ALIPAY_MERCHANT_PRIVATE_KEY=your_merchant_private_key_here

# 支付宝公钥（用于验签）
ALIPAY_PUBLIC_KEY=alipay_public_key_here

# 支付回调通知URL（需外网可访问）
ALIPAY_NOTIFY_URL=http://your-domain.com/api/v1/alipay/notify

# 支付完成跳转URL
ALIPAY_RETURN_URL=http://your-domain.com/order/success

# ==================== 应用日志配置 ====================
# 日志存储路径（可选）
APP_LOG_PATH=./data/log